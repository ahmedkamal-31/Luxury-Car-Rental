@model List<LuxuryCarRental.Models.Car>
@{
    ViewData["Title"] = "Fleet Management";
}

<div class="container py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-dark text-success border-success rounded-0 mb-4">@TempData["SuccessMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-uppercase mb-1">FLEET <span class="text-gold">MANAGEMENT</span></h2>
            <p class="text-muted small mb-0">View, add, edit, or remove vehicles from your rental catalogue.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-gold rounded-0 fw-bold text-uppercase">
                <i class="bi bi-plus-lg me-1"></i> Add New Car
            </a>
        </div>
    </div>

    <div class="card luxury-card rounded-0 p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle border-secondary">
                <thead>
                    <tr class="text-gold">
                        <th>Image</th>
                        <th>Name</th>
                        <th>Brand / Category</th>
                        <th>Year</th>
                        <th>Daily Price</th>
                        <th>Featured</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No cars available. Click "Add New Car" to get started.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var car in Model)
                        {
                            var img = car.CarImages.FirstOrDefault(i => i.IsPrimary)?.ImagePath ?? "https://images.unsplash.com/photo-1544829099-b9a0c07fad1a?auto=format&fit=crop&w=1200&q=80";
                            <tr>
                                <td>
                                    <img src="@img" style="width: 80px; height: 50px; object-fit: cover;" class="border border-secondary" />
                                </td>
                                <td>
                                    <strong>@car.Name</strong><br />
                                    <small class="text-muted">@car.Color | @car.Engine</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary me-1">@car.Brand?.Name</span>
                                    <span class="badge bg-dark border border-secondary">@car.Category?.Name</span>
                                </td>
                                <td>@car.Year</td>
                                <td class="text-gold fw-bold">AED @car.DailyPrice.ToString("N0")</td>
                                <td>
                                    @if (car.IsFeatured)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i> Featured</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Standard</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-warning rounded-0"><i class="bi bi-pencil"></i> Edit</a>
                                        <form asp-action="Delete" asp-route-id="@car.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this car?');" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-0"><i class="bi bi-trash"></i> Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
