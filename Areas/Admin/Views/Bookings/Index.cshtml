@model IEnumerable<LuxuryCarRental.Models.Booking>

@{
    ViewData["Title"] = "Manage Bookings";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-gold text-uppercase fw-bold mb-0"><i class="bi bi-card-checklist me-2"></i> All Customer Bookings</h2>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light btn-sm rounded-0">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    <div class="card bg-black border-secondary rounded-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="table-secondary text-uppercase small">
                        <tr>
                            <th>#</th>
                            <th>Car</th>
                            <th>Dates</th>
                            <th>Total Price</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No bookings found in database.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        <div class="fw-bold">@(item.Car != null ? $"{item.Car.Brand?.Name} {item.Car.Name}" : $"Car #{item.CarId}")</div>
                                        <small class="text-muted">User ID: @item.UserId</small>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-calendar-event text-gold me-1"></i> @item.StartDate.ToString("MMM dd, yyyy")</div>
                                        <div><i class="bi bi-calendar-check text-muted me-1"></i> @item.EndDate.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td class="text-gold fw-bold">$@item.TotalPrice.ToString("N0")</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark text-uppercase px-2 py-1">Pending</span>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success text-uppercase px-2 py-1">Confirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-uppercase px-2 py-1">Cancelled</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form asp-area="Admin" asp-controller="Bookings" asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="status" value="Confirmed" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-0 text-uppercase fw-bold me-1" @(item.Status == "Confirmed" ? "disabled" : "")>
                                                Approve
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="Bookings" asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="status" value="Cancelled" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-0 text-uppercase fw-bold" @(item.Status == "Cancelled" ? "disabled" : "")>
                                                Cancel
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

