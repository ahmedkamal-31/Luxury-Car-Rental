@model IEnumerable<LuxuryCarRental.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container py-5">
    <h2 class="text-gold text-uppercase fw-bold mb-4"><i class="bi bi-journal-bookmark me-2"></i> My Bookings</h2>

    @if (!Model.Any())
    {
        <div class="alert bg-black border-secondary text-light p-4 rounded-0 text-center">
            <p class="mb-3">You have no active or previous reservations.</p>
            <a asp-controller="Cars" asp-action="Index" class="btn btn-gold text-uppercase fw-bold rounded-0">Explore Our Fleet</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card bg-black border-secondary rounded-0 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="text-light fw-bold mb-0">@(booking.Car != null ? $"{booking.Car.Brand?.Name} {booking.Car.Name}" : "Luxury Vehicle")</h5>
                                    <small class="text-muted">Booking #@booking.Id</small>
                                </div>
                                @if (booking.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark text-uppercase px-2 py-1">Pending</span>
                                }
                                else if (booking.Status == "Confirmed")
                                {
                                    <span class="badge bg-success text-uppercase px-2 py-1">Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-uppercase px-2 py-1">Cancelled</span>
                                }
                            </div>
                            <hr class="border-secondary" />
                            <div class="mb-2">
                                <small class="text-muted text-uppercase d-block">Pick-up Date</small>
                                <span class="text-light fw-semibold"><i class="bi bi-calendar-event text-gold me-2"></i>@booking.StartDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted text-uppercase d-block">Return Date</small>
                                <span class="text-light fw-semibold"><i class="bi bi-calendar-check text-gold me-2"></i>@booking.EndDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary">
                                <span class="text-muted small text-uppercase">Total Cost</span>
                                <span class="text-gold fw-bold fs-5">$@booking.TotalPrice.ToString("N0")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

