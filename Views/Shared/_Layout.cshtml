<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LuxuryCarRental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-uppercase tracking-wider fs-4" asp-area="" asp-area="" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="text-gold">LUXURY</span> CARS
                </a>
                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-lg-center gap-3">
                        <li class="nav-item">
                            <a class="nav-link text-uppercase small text-light fw-semibold" asp-area="" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
    <li class="nav-item"><a class="nav-link text-white text-uppercase" href="/Cars">Our Fleet</a></li>
@if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
{
    <li class="nav-item">
        <a class="nav-link text-uppercase fw-bold" href="/Bookings/MyBookings" style="color: #d4af37 !important;">My Bookings</a>
    </li>
}

                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-uppercase small text-gold fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                </li>
                            }
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-0 text-uppercase px-3">Logout</button>
                                </form>


                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm rounded-0 text-uppercase px-3" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">

                                <a class="btn btn-gold btn-sm rounded-0 text-uppercase px-3 fw-bold" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    

</ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="bg-black text-muted py-4 border-top border-secondary mt-5">
        <div class="container text-center">
            <p class="mb-1 text-light fw-bold text-uppercase tracking-wider small">Luxury Car Rental UAE</p>
            <p class="small mb-0 text-muted">&copy; 2026 - All Rights Reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>









