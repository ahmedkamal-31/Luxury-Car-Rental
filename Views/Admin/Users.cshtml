@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "User Management";
}

<div class="container py-4 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold" style="color: #d4af37;">User Management</h2>
        <a href="/Admin" class="btn btn-outline-light btn-sm">Back to Dashboard</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-dark text-success border-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger bg-dark text-danger border-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive rounded border border-secondary bg-black p-3">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr class="text-secondary border-bottom border-secondary">
                    <th>Email / Username</th>
                    <th>User ID</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    bool isBlocked = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow;
                    <tr>
                        <td class="fw-semibold text-white">@user.Email</td>
                        <td class="text-muted small">@user.Id</td>
                        <td>
                            @if (isBlocked)
                            {
                                <span class="badge bg-danger text-uppercase">Blocked</span>
                            }
                            else
                            {
                                <span class="badge bg-success text-uppercase">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleBlockUser" method="post" class="d-inline">
                                <input type="hidden" name="userId" value="@user.Id" />
                                @if (isBlocked)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-unlock"></i> Unblock
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to block this user?');">
                                        <i class="bi bi-slash-circle"></i> Block
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
